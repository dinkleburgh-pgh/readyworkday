# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# ── PostgreSQL ──────────────────────────────────────────────────
TRUCKAPP_PG_HOST=192.168.1.XXX     # TrueNAS IP or hostname
TRUCKAPP_PG_PORT=5432
TRUCKAPP_PG_DBNAME=truckapp
TRUCKAPP_PG_USER=truckapp
TRUCKAPP_PG_PASSWORD=change_me_strong_password
TRUCKAPP_PG_SSLMODE=prefer         # use 'require' over untrusted networks
TRUCKAPP_PG_MINCONN=2
TRUCKAPP_PG_MAXCONN=10

# ── Existing app vars (keep these) ──────────────────────────────
TRUCKAPP_AUTH_COOKIE_NAME=truckapp_auth
TRUCKAPP_AUTH_COOKIE_KEY=replace_with_32_random_chars
TRUCKAPP_AUTH_COOKIE_DAYS=7
HOST_PORT=8501
